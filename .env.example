# Optional GitHub backend. Leave disabled for local-only writing.
# Copy to .env.local for local development. Never use VITE_ for secrets.
GITHUB_ENABLED=false
GITHUB_SITE_ORIGIN=http://localhost:5173
GITHUB_REPOSITORY=c-x-x/c-x-x.github.io
GITHUB_BASE_BRANCH=main
GITHUB_CONTENT_ROOT=content/posts
# Numeric GitHub account ID, not username
GITHUB_ALLOWED_USER_ID=
# GitHub App OAuth credentials (not a personal access token)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Generate with: openssl rand -hex 32
GITHUB_SESSION_SECRET=
